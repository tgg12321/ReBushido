# Build files must be LF: the GNU toolchain and bash break on CRLF.
*.c                              text eol=lf
*.h                              text eol=lf
*.ld                             text eol=lf
*.sh                             text eol=lf
Makefile                         text eol=lf
asm/**/*.s                       text eol=lf
movovl/asm/**/*.s                text eol=lf
config/*                         text eol=lf
movovl/undefined_syms.txt        text eol=lf
