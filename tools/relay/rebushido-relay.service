# The ReBushido lobby, rendezvous and relay server, UDP 7845.
# Installed by tools/relay/deploy.sh as /etc/systemd/system/rebushido-relay.service.
[Unit]
Description=ReBushido lobby, rendezvous and relay server (UDP 7845)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
# No --listen: 0.0.0.0:7845, and [::]:7845 where the box has IPv6. The
# ranked ladder's store in the state folder below (docs/NETPLAY.md, 17).
ExecStart=/usr/bin/python3 -I -u /opt/rebushido-relay/rebushido_relay.py --state /var/lib/rebushido-relay
Restart=on-failure
RestartSec=2

# A user made for each start and gone after it. The one folder it writes is
# its state folder: systemd makes /var/lib/private/rebushido-relay, gives it
# to the user of each start, and keeps it across restarts, stops and
# redeploys (deploy.sh never removes it; `uninstall --purge` does). Only
# that user and root can read it.
DynamicUser=yes
StateDirectory=rebushido-relay
StateDirectoryMode=0700
NoNewPrivileges=yes
CapabilityBoundingSet=
AmbientCapabilities=
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
PrivateIPC=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
ProtectProc=invisible
ProcSubset=pid
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
RemoveIPC=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallFilter=~@privileged
SystemCallErrorNumber=EPERM
UMask=0077

# What it may use: a few sockets, little memory, a share of one processor.
LimitNOFILE=64
TasksMax=8
MemoryMax=256M
CPUQuota=100%

[Install]
WantedBy=multi-user.target
