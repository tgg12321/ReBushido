# The ReBushido lobby, rendezvous and relay server, UDP 7845.
# Installed by tools/relay/deploy.sh as /etc/systemd/system/rebushido-relay.service.
[Unit]
Description=ReBushido lobby, rendezvous and relay server (UDP 7845)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
# No --listen: 0.0.0.0:7845, and [::]:7845 where the box has IPv6.
ExecStart=/usr/bin/python3 -I -u /opt/rebushido-relay/rebushido_relay.py
Restart=on-failure
RestartSec=2

# A user made for each start and gone after it: the server owns no file and
# writes none, so there is no account to keep or to remove.
DynamicUser=yes
NoNewPrivileges=yes
CapabilityBoundingSet=
AmbientCapabilities=
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
PrivateIPC=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
ProtectProc=invisible
ProcSubset=pid
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
RemoveIPC=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallFilter=~@privileged
SystemCallErrorNumber=EPERM
UMask=0077

# What it may use: a few sockets, little memory, a share of one processor.
LimitNOFILE=64
TasksMax=8
MemoryMax=256M
CPUQuota=100%

[Install]
WantedBy=multi-user.target
